<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- 浅色模式的配色令牌 -->
    <SolidColorBrush x:Key="SurfaceBrush" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="ElevatedBrush" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="SurfaceMutedBrush" Color="#F3F5F8"/>
    <SolidColorBrush x:Key="InputBrush" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="SurfaceAltBrush" Color="#F1F4F8"/>
    <SolidColorBrush x:Key="PressedBrush" Color="#E9EEF3"/>
    <SolidColorBrush x:Key="LineBrush" Color="#E1E6ED"/>
    <SolidColorBrush x:Key="LineSoftBrush" Color="#EDF1F6"/>
    <SolidColorBrush x:Key="LineStrongBrush" Color="#C9D3DF"/>
    <SolidColorBrush x:Key="TextBrush" Color="#242833"/>
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="#626875"/>
    <SolidColorBrush x:Key="TextMutedBrush" Color="#8A919E"/>
    <SolidColorBrush x:Key="AccentBrush" Color="#1A87B0"/>
    <SolidColorBrush x:Key="AccentHoverBrush" Color="#15789D"/>
    <SolidColorBrush x:Key="AccentPressedBrush" Color="#10688A"/>
    <SolidColorBrush x:Key="OnAccentBrush" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="AccentTintBrush" Color="#E6F4F9"/>
    <SolidColorBrush x:Key="AccentTintHoverBrush" Color="#D8EEF6"/>
    <SolidColorBrush x:Key="SelectionBrush" Color="#B7DDEA"/>
    <SolidColorBrush x:Key="TrackBrush" Color="#D9E3EB"/>
    <SolidColorBrush x:Key="SuccessBrush" Color="#14845F"/>
    <SolidColorBrush x:Key="SoftButtonBorderBrush" Color="#B9DDEA"/>
    <SolidColorBrush x:Key="SoftButtonPressedBrush" Color="#CDE9F3"/>
    <SolidColorBrush x:Key="ScrollThumbBrush" Color="#C4CFDC"/>
    <SolidColorBrush x:Key="ScrollThumbHoverBrush" Color="#AEBCCB"/>
    <SolidColorBrush x:Key="ScrollThumbDragBrush" Color="#98A9BA"/>
    <SolidColorBrush x:Key="HeaderTitleBrush" Color="#242833"/>

    <SolidColorBrush x:Key="AppBackgroundBrush" Color="#F7F8FA"/>

    <RadialGradientBrush x:Key="GlowBrush">
        <GradientStop Color="#141A87B0" Offset="0"/>
        <GradientStop Color="#001A87B0" Offset="1"/>
    </RadialGradientBrush>

    <DrawingBrush x:Key="CheckerBrush" TileMode="Tile" Stretch="None"
                  Viewport="0,0,24,24" ViewportUnits="Absolute">
        <DrawingBrush.Drawing>
            <DrawingGroup>
                <GeometryDrawing Brush="#FBFCFD" Geometry="M0,0 H24 V24 H0 Z"/>
                <GeometryDrawing Brush="#F1F4F8">
                    <GeometryDrawing.Geometry>
                        <GeometryGroup>
                            <RectangleGeometry Rect="0,0,12,12"/>
                            <RectangleGeometry Rect="12,12,12,12"/>
                        </GeometryGroup>
                    </GeometryDrawing.Geometry>
                </GeometryDrawing>
            </DrawingGroup>
        </DrawingBrush.Drawing>
    </DrawingBrush>

    <DropShadowEffect x:Key="ThumbShadowEffect" Color="#000000" BlurRadius="6" ShadowDepth="0" Opacity="0.12"/>
    <DropShadowEffect x:Key="TabShadowEffect" Color="#1F2933" BlurRadius="14" ShadowDepth="2" Opacity="0.12"/>
</ResourceDictionary>
