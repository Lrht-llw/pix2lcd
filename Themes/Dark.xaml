<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- 深色模式的配色令牌 -->
    <SolidColorBrush x:Key="SurfaceBrush" Color="#1F242B"/>
    <SolidColorBrush x:Key="ElevatedBrush" Color="#2A313A"/>
    <SolidColorBrush x:Key="SurfaceMutedBrush" Color="#191D23"/>
    <SolidColorBrush x:Key="InputBrush" Color="#171B21"/>
    <SolidColorBrush x:Key="SurfaceAltBrush" Color="#272D36"/>
    <SolidColorBrush x:Key="PressedBrush" Color="#222831"/>
    <SolidColorBrush x:Key="LineBrush" Color="#343B46"/>
    <SolidColorBrush x:Key="LineSoftBrush" Color="#2A3039"/>
    <SolidColorBrush x:Key="LineStrongBrush" Color="#48515F"/>
    <SolidColorBrush x:Key="TextBrush" Color="#E9ECF1"/>
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="#A9B2C0"/>
    <SolidColorBrush x:Key="TextMutedBrush" Color="#8B97A8"/>
    <SolidColorBrush x:Key="AccentBrush" Color="#E3E8EF"/>
    <SolidColorBrush x:Key="AccentHoverBrush" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="AccentPressedBrush" Color="#C2CAD6"/>
    <SolidColorBrush x:Key="OnAccentBrush" Color="#161A1F"/>
    <SolidColorBrush x:Key="AccentTintBrush" Color="#2E3641"/>
    <SolidColorBrush x:Key="AccentTintHoverBrush" Color="#3A4350"/>
    <SolidColorBrush x:Key="SelectionBrush" Color="#4B5666"/>
    <SolidColorBrush x:Key="TrackBrush" Color="#3B4451"/>
    <SolidColorBrush x:Key="SuccessBrush" Color="#5BC79B"/>
    <SolidColorBrush x:Key="SoftButtonBorderBrush" Color="#46505E"/>
    <SolidColorBrush x:Key="SoftButtonPressedBrush" Color="#3F4A59"/>
    <SolidColorBrush x:Key="ScrollThumbBrush" Color="#4A5462"/>
    <SolidColorBrush x:Key="ScrollThumbHoverBrush" Color="#5E6A7A"/>
    <SolidColorBrush x:Key="ScrollThumbDragBrush" Color="#728094"/>
    <SolidColorBrush x:Key="HeaderTitleBrush" Color="#FFFFFF"/>

    <LinearGradientBrush x:Key="AppBackgroundBrush" StartPoint="0,0" EndPoint="0.35,1">
        <GradientStop Color="#13161B" Offset="0"/>
        <GradientStop Color="#1A1F26" Offset="1"/>
    </LinearGradientBrush>

    <RadialGradientBrush x:Key="GlowBrush">
        <GradientStop Color="#14FFFFFF" Offset="0"/>
        <GradientStop Color="#00FFFFFF" Offset="1"/>
    </RadialGradientBrush>

    <DrawingBrush x:Key="CheckerBrush" TileMode="Tile" Stretch="None"
                  Viewport="0,0,24,24" ViewportUnits="Absolute">
        <DrawingBrush.Drawing>
            <DrawingGroup>
                <GeometryDrawing Brush="#1A1E24" Geometry="M0,0 H24 V24 H0 Z"/>
                <GeometryDrawing Brush="#20252C">
                    <GeometryDrawing.Geometry>
                        <GeometryGroup>
                            <RectangleGeometry Rect="0,0,12,12"/>
                            <RectangleGeometry Rect="12,12,12,12"/>
                        </GeometryGroup>
                    </GeometryDrawing.Geometry>
                </GeometryDrawing>
            </DrawingGroup>
        </DrawingBrush.Drawing>
    </DrawingBrush>

    <DropShadowEffect x:Key="ThumbShadowEffect" Color="#000000" BlurRadius="6" ShadowDepth="0" Opacity="0.45"/>
    <DropShadowEffect x:Key="TabShadowEffect" Color="#000000" BlurRadius="14" ShadowDepth="2" Opacity="0.45"/>
</ResourceDictionary>
