<UserControl x:Class="pix2lcd.Views.ImageModule"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="Transparent">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="212"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ================= 工具栏 ================= -->
        <Border Grid.Row="0" Style="{StaticResource CardStyle}" Margin="0,0,0,10">
            <StackPanel>
                <WrapPanel Orientation="Horizontal">
                    <Button x:Name="openBtn" Content="打开图片…" Style="{StaticResource SoftButtonStyle}"
                            Width="104" Height="30" Margin="0,0,10,0" Click="OnOpen"/>
                    <TextBlock x:Name="fileLabel" Text="（未加载图片）" VerticalAlignment="Center"
                               Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12"
                               MaxWidth="240" TextTrimming="CharacterEllipsis" Margin="0,0,8,0"/>
                    <TextBlock Text="拖入窗口即可加载" Style="{StaticResource HintStyle}" Margin="0,0,4,0"/>

                    <Rectangle Style="{StaticResource ToolbarDividerStyle}"/>

                    <TextBlock Text="色深" Style="{StaticResource FieldLabelStyle}" Margin="0,0,6,0"/>
                    <ComboBox x:Name="depthBox" Width="158" Height="30" Margin="0,0,10,0"
                              SelectionChanged="OnSelectionChanged"/>

                    <TextBlock Text="扫描" Style="{StaticResource FieldLabelStyle}" Margin="0,0,6,0"/>
                    <ComboBox x:Name="scanBox" Width="230" Height="30" Margin="0,0,4,0"
                              SelectionChanged="OnSelectionChanged"/>

                    <Rectangle Style="{StaticResource ToolbarDividerStyle}"/>

                    <TextBlock Text="输出" Style="{StaticResource FieldLabelStyle}" Margin="0,0,6,0"/>
                    <TextBox x:Name="outWidthBox" Width="56" Height="30" Text="128"
                             VerticalContentAlignment="Center" TextChanged="OnTextChanged"/>
                    <TextBlock Text="×" Style="{StaticResource FieldLabelStyle}" Margin="4,0,4,0"/>
                    <TextBox x:Name="outHeightBox" Width="56" Height="30" Text="64"
                             VerticalContentAlignment="Center" TextChanged="OnTextChanged"/>
                    <Button Content="按原图" Width="64" Height="30" Margin="8,0,0,0" Click="OnUseOriginalSize"/>
                </WrapPanel>

                <WrapPanel Orientation="Horizontal" Margin="0,10,0,0">
                    <TextBlock Text="单色阈值" Style="{StaticResource FieldLabelStyle}" Margin="2,0,6,0"/>
                    <Slider x:Name="thresholdSlider" Width="120" Minimum="1" Maximum="254" Value="128"
                            ValueChanged="OnSliderChanged"/>
                    <TextBlock x:Name="thresholdLabel" Text="128" Width="34" VerticalAlignment="Center"
                               FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}"
                               Margin="4,0,12,0"/>

                    <TextBlock Text="亮度" Style="{StaticResource FieldLabelStyle}" Margin="0,0,6,0"/>
                    <Slider x:Name="brightSlider" Width="104" Minimum="-100" Maximum="100" Value="0"
                            ValueChanged="OnSliderChanged"/>
                    <TextBlock x:Name="brightLabel" Text="0" Width="34" VerticalAlignment="Center"
                               FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}"
                               Margin="4,0,12,0"/>

                    <TextBlock Text="对比度" Style="{StaticResource FieldLabelStyle}" Margin="0,0,6,0"/>
                    <Slider x:Name="contrastSlider" Width="104" Minimum="-100" Maximum="100" Value="0"
                            ValueChanged="OnSliderChanged"/>
                    <TextBlock x:Name="contrastLabel" Text="0" Width="34" VerticalAlignment="Center"
                               FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}"
                               Margin="4,0,12,0"/>

                    <Rectangle Style="{StaticResource ToolbarDividerStyle}"/>

                    <CheckBox x:Name="invertBox" Content="反色" VerticalAlignment="Center" Margin="0,0,14,0"
                              Checked="OnCheckedChanged" Unchecked="OnCheckedChanged"/>
                    <CheckBox x:Name="msbBox" Content="高位在前" IsChecked="True" VerticalAlignment="Center"
                              Margin="0,0,14,0" Checked="OnCheckedChanged" Unchecked="OnCheckedChanged"/>
                    <CheckBox x:Name="mirrorHBox" Content="水平镜像" VerticalAlignment="Center" Margin="0,0,14,0"
                              Checked="OnCheckedChanged" Unchecked="OnCheckedChanged"/>
                    <CheckBox x:Name="mirrorVBox" Content="垂直镜像" VerticalAlignment="Center" Margin="0,0,14,0"
                              Checked="OnCheckedChanged" Unchecked="OnCheckedChanged"/>
                    <CheckBox x:Name="commentBox" Content="输出注释" IsChecked="True" VerticalAlignment="Center"
                              Checked="OnCheckedChanged" Unchecked="OnCheckedChanged"/>
                </WrapPanel>
            </StackPanel>
        </Border>

        <!-- ================= 预览 ================= -->
        <Grid Grid.Row="1" Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Style="{StaticResource CardStyle}" Padding="0" Margin="0,0,10,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <Grid Grid.Row="0" Margin="14,11,14,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="原始图像" Style="{StaticResource SectionTitleStyle}"/>
                        <TextBlock Grid.Column="1" HorizontalAlignment="Right" Style="{StaticResource HintStyle}"
                                   Text="参考画面，不做取模"/>
                    </Grid>
                    <Border Grid.Row="1" Style="{StaticResource InsetStyle}" Margin="14,0,14,14"
                            Background="{DynamicResource CheckerBrush}">
                        <Image x:Name="sourceImage" Stretch="Uniform" Margin="12"
                               RenderOptions.BitmapScalingMode="HighQuality"/>
                    </Border>
                </Grid>
            </Border>

            <Border Grid.Column="1" Style="{StaticResource CardStyle}" Padding="0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <Grid Grid.Row="0" Margin="14,11,14,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" x:Name="previewLabel" Text="取模后的量化效果"
                                   Style="{StaticResource SectionTitleStyle}"
                                   TextTrimming="CharacterEllipsis"/>
                    </Grid>
                    <Border Grid.Row="1" Style="{StaticResource InsetStyle}" Margin="14,0,14,14">
                        <Image x:Name="previewImage" Stretch="Uniform" Margin="12"
                               RenderOptions.BitmapScalingMode="NearestNeighbor"/>
                    </Border>
                </Grid>
            </Border>
        </Grid>

        <!-- ================= 输出 ================= -->
        <Border Grid.Row="2" Style="{StaticResource CardStyle}" Padding="0" Margin="0,0,0,10">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <Grid Grid.Row="0" Margin="14,10,14,6">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="图像数据输出区" Style="{StaticResource SectionTitleStyle}"/>
                    <TextBlock Grid.Column="1" x:Name="byteLabel" Margin="12,0,0,0" FontSize="12"
                               Foreground="{DynamicResource TextMutedBrush}" VerticalAlignment="Center"/>
                    <TextBlock Grid.Column="2" HorizontalAlignment="Right" Style="{StaticResource HintStyle}"
                               Text="C 数组 / BIN 均可保存"/>
                </Grid>
                <TextBox Grid.Row="1" x:Name="outputBox" IsReadOnly="True" AcceptsReturn="True"
                         FontFamily="Consolas, 宋体" FontSize="12" Padding="10,8"
                         Background="{DynamicResource SurfaceMutedBrush}"
                         BorderBrush="{DynamicResource LineSoftBrush}"
                         VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
                         TextWrapping="NoWrap" Margin="14,0,14,14"/>
            </Grid>
        </Border>

        <!-- ================= 操作按钮 ================= -->
        <Grid Grid.Row="3">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <Ellipse Grid.Column="0" Width="7" Height="7" Fill="{DynamicResource AccentBrush}"
                     VerticalAlignment="Center" Margin="2,0,8,0">
                <Ellipse.Style>
                    <Style TargetType="{x:Type Ellipse}">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding Text, ElementName=statusLabel}" Value="">
                                <Setter Property="Visibility" Value="Collapsed"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Ellipse.Style>
            </Ellipse>
            <TextBlock Grid.Column="1" x:Name="statusLabel" VerticalAlignment="Center" FontSize="12"
                       Foreground="{DynamicResource TextSecondaryBrush}" TextTrimming="CharacterEllipsis"
                       Margin="0,0,16,0"/>
            <StackPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="保存 BIN" Height="34" Width="92" Margin="0,0,6,0" Click="OnSaveBin"/>
                <Button Content="保存 C 文件" Height="34" Width="104" Margin="0,0,6,0" Click="OnSaveC"/>
                <Button Content="复制输出" Height="34" Width="92" Margin="0,0,6,0" Click="OnCopy"/>
                <Button Content="生成数据" Style="{StaticResource PrimaryButtonStyle}" Height="34" Width="112"
                        Click="OnGenerate"/>
            </StackPanel>
        </Grid>
    </Grid>
</UserControl>
