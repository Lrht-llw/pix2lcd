<UserControl x:Class="pix2lcd.Views.ImageModule"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="Transparent">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="230"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ================= 工具栏 ================= -->
        <Border Grid.Row="0" Background="White" CornerRadius="4" Padding="8" Margin="0,0,0,6">
            <StackPanel>
                <WrapPanel Orientation="Horizontal">
                    <Button x:Name="openBtn" Content="打开图片…" Width="92" Height="26" Margin="0,0,10,0"
                            Click="OnOpen"/>
                    <TextBlock x:Name="fileLabel" Text="（未加载图片）" VerticalAlignment="Center"
                               Foreground="#666" Margin="0,0,16,0"/>

                    <TextBlock Text="色深:" VerticalAlignment="Center" Margin="0,0,4,0"/>
                    <ComboBox x:Name="depthBox" Width="150" Height="26" Margin="0,0,10,0"
                              SelectionChanged="OnSelectionChanged"/>

                    <TextBlock Text="扫描:" VerticalAlignment="Center" Margin="0,0,4,0"/>
                    <ComboBox x:Name="scanBox" Width="230" Height="26" Margin="0,0,10,0"
                              SelectionChanged="OnSelectionChanged"/>

                    <TextBlock Text="输出:" VerticalAlignment="Center" Margin="0,0,4,0"/>
                    <TextBox x:Name="outWidthBox" Width="52" Height="26" Text="128"
                             VerticalContentAlignment="Center" TextChanged="OnTextChanged"/>
                    <TextBlock Text="×" VerticalAlignment="Center" Margin="3,0"/>
                    <TextBox x:Name="outHeightBox" Width="52" Height="26" Text="64"
                             VerticalContentAlignment="Center" TextChanged="OnTextChanged"/>
                    <Button Content="按原图" Width="58" Height="26" Margin="6,0,10,0" Click="OnUseOriginalSize"/>
                </WrapPanel>

                <WrapPanel Orientation="Horizontal" Margin="0,8,0,0">
                    <TextBlock Text="单色阈值:" VerticalAlignment="Center" Margin="0,0,4,0"/>
                    <Slider x:Name="thresholdSlider" Width="120" Minimum="1" Maximum="254" Value="128"
                            VerticalAlignment="Center" ValueChanged="OnSliderChanged"/>
                    <TextBlock x:Name="thresholdLabel" Text="128" Width="30" VerticalAlignment="Center"
                               Margin="6,0,12,0"/>

                    <TextBlock Text="亮度:" VerticalAlignment="Center" Margin="0,0,4,0"/>
                    <Slider x:Name="brightSlider" Width="100" Minimum="-100" Maximum="100" Value="0"
                            VerticalAlignment="Center" ValueChanged="OnSliderChanged"/>
                    <TextBlock x:Name="brightLabel" Text="0" Width="34" VerticalAlignment="Center"
                               Margin="6,0,12,0"/>

                    <TextBlock Text="对比度:" VerticalAlignment="Center" Margin="0,0,4,0"/>
                    <Slider x:Name="contrastSlider" Width="100" Minimum="-100" Maximum="100" Value="0"
                            VerticalAlignment="Center" ValueChanged="OnSliderChanged"/>
                    <TextBlock x:Name="contrastLabel" Text="0" Width="34" VerticalAlignment="Center"
                               Margin="6,0,14,0"/>

                    <CheckBox x:Name="invertBox" Content="反色" VerticalAlignment="Center" Margin="0,0,12,0"
                              Checked="OnCheckedChanged" Unchecked="OnCheckedChanged"/>
                    <CheckBox x:Name="msbBox" Content="高位在前" IsChecked="True" VerticalAlignment="Center"
                              Margin="0,0,12,0" Checked="OnCheckedChanged" Unchecked="OnCheckedChanged"/>
                    <CheckBox x:Name="mirrorHBox" Content="水平镜像" VerticalAlignment="Center" Margin="0,0,12,0"
                              Checked="OnCheckedChanged" Unchecked="OnCheckedChanged"/>
                    <CheckBox x:Name="mirrorVBox" Content="垂直镜像" VerticalAlignment="Center" Margin="0,0,12,0"
                              Checked="OnCheckedChanged" Unchecked="OnCheckedChanged"/>
                    <CheckBox x:Name="commentBox" Content="输出注释" IsChecked="True" VerticalAlignment="Center"
                              Checked="OnCheckedChanged" Unchecked="OnCheckedChanged"/>
                </WrapPanel>
            </StackPanel>
        </Border>

        <!-- ================= 预览 ================= -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Border Grid.Column="0" Background="White" CornerRadius="4" Margin="0,0,6,6">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <TextBlock Grid.Row="0" Text="原始图像" Margin="8,6" FontWeight="SemiBold"/>
                    <ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Auto"
                                  VerticalScrollBarVisibility="Auto" Margin="6">
                        <Image x:Name="sourceImage" Stretch="Uniform"
                               RenderOptions.BitmapScalingMode="NearestNeighbor"/>
                    </ScrollViewer>
                </Grid>
            </Border>
            <Border Grid.Column="1" Background="White" CornerRadius="4" Margin="0,0,0,6">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <TextBlock Grid.Row="0" x:Name="previewLabel" Text="取模后的量化效果" Margin="8,6"
                               FontWeight="SemiBold"/>
                    <ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Auto"
                                  VerticalScrollBarVisibility="Auto" Margin="6">
                        <Image x:Name="previewImage" Stretch="Uniform"
                               RenderOptions.BitmapScalingMode="NearestNeighbor"/>
                    </ScrollViewer>
                </Grid>
            </Border>
        </Grid>

        <!-- ================= 输出 ================= -->
        <Border Grid.Row="2" Background="White" CornerRadius="4" Margin="0,0,0,6">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="8,6,0,2">
                    <TextBlock Text="图像数据输出区" FontWeight="SemiBold"/>
                    <TextBlock x:Name="byteLabel" Margin="16,0,0,0" Foreground="#666"/>
                </StackPanel>
                <TextBox Grid.Row="1" x:Name="outputBox" IsReadOnly="True" AcceptsReturn="True"
                         FontFamily="Consolas, 宋体" FontSize="12" Margin="6"
                         VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
                         TextWrapping="NoWrap"/>
            </Grid>
        </Border>

        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right">
            <TextBlock x:Name="statusLabel" VerticalAlignment="Center" Margin="0,0,16,0" Foreground="#666"/>
            <Button Content="生成数据" Width="110" Height="30" Margin="0,0,8,0" Click="OnGenerate"/>
            <Button Content="复制输出" Width="90" Height="30" Margin="0,0,8,0" Click="OnCopy"/>
            <Button Content="保存 C 文件" Width="110" Height="30" Margin="0,0,8,0" Click="OnSaveC"/>
            <Button Content="保存 BIN" Width="90" Height="30" Click="OnSaveBin"/>
        </StackPanel>
    </Grid>
</UserControl>
