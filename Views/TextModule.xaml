<UserControl x:Class="pix2lcd.Views.TextModule"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="Transparent">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="240"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ================= 工具栏 ================= -->
        <Border Grid.Row="0" Background="White" CornerRadius="4" Padding="8" Margin="0,0,0,6">
            <WrapPanel Orientation="Horizontal">
                <TextBlock Text="字体:" VerticalAlignment="Center" Margin="0,0,4,0"/>
                <ComboBox x:Name="fontBox" Width="170" Height="26" Margin="0,0,10,0"
                          SelectionChanged="OnSelectionChanged"/>

                <TextBlock Text="字宽:" VerticalAlignment="Center" Margin="0,0,4,0"/>
                <ComboBox x:Name="widthBox" Width="62" Height="26" IsEditable="True" Margin="0,0,6,0"
                          SelectionChanged="OnSelectionChanged" LostFocus="OnLostFocus"/>

                <TextBlock Text="字高:" VerticalAlignment="Center" Margin="0,0,4,0"/>
                <ComboBox x:Name="heightBox" Width="62" Height="26" IsEditable="True" Margin="0,0,6,0"
                          SelectionChanged="OnSelectionChanged" LostFocus="OnLostFocus"/>

                <CheckBox x:Name="scaleBox" Content="等比" IsChecked="True" VerticalAlignment="Center"
                          Margin="0,0,10,0" Checked="OnCheckedChanged" Unchecked="OnCheckedChanged"/>

                <ToggleButton x:Name="boldBtn" Content="B" Width="28" Height="26" FontWeight="Bold" Margin="0,0,2,0"
                              Checked="OnCheckedChanged" Unchecked="OnCheckedChanged"/>
                <ToggleButton x:Name="italicBtn" Content="I" Width="28" Height="26" FontStyle="Italic" Margin="0,0,2,0"
                              Checked="OnCheckedChanged" Unchecked="OnCheckedChanged"/>
                <ToggleButton x:Name="underlineBtn" Content="U" Width="28" Height="26"
                              Margin="0,0,10,0" Checked="OnCheckedChanged" Unchecked="OnCheckedChanged"/>

                <Button Content="⟲" ToolTip="左旋 90°" Width="32" Height="26" Margin="0,0,2,0" Click="OnRotateLeft"/>
                <Button Content="⟳" ToolTip="右旋 90°" Width="32" Height="26" Margin="0,0,2,0" Click="OnRotateRight"/>
                <Button Content="⇋" ToolTip="水平翻转" Width="32" Height="26" Margin="0,0,2,0" Click="OnFlipH"/>
                <Button Content="⇅" ToolTip="垂直翻转" Width="32" Height="26" Margin="0,0,8,0" Click="OnFlipV"/>
                <Button Content="去空白" ToolTip="裁掉四周空白" Width="60" Height="26" Margin="0,0,8,0" Click="OnTrim"/>
                <Button Content="复位" ToolTip="重新按字体渲染" Width="50" Height="26" Margin="0,0,10,0" Click="OnReset"/>

                <TextBlock Text="点阵:" VerticalAlignment="Center" Margin="0,0,4,0"/>
                <ComboBox x:Name="dotWidthBox" Width="58" Height="26" IsEditable="True" Margin="0,0,2,0"
                          SelectionChanged="OnSelectionChanged" LostFocus="OnLostFocus"/>
                <TextBlock Text="×" VerticalAlignment="Center" Margin="0,0,2,0"/>
                <ComboBox x:Name="dotHeightBox" Width="58" Height="26" IsEditable="True" Margin="0,0,6,0"
                          SelectionChanged="OnSelectionChanged" LostFocus="OnLostFocus"/>
                <CheckBox x:Name="lockSizeBox" Content="锁定" VerticalAlignment="Center" Margin="0,0,10,0"
                          Checked="OnCheckedChanged" Unchecked="OnCheckedChanged"/>

                <TextBlock Text="文字:" VerticalAlignment="Center" Margin="0,0,4,0"/>
                <TextBox x:Name="textBox" Width="220" Height="26" VerticalContentAlignment="Center"
                         Text="字模ABC" TextChanged="OnTextChanged"/>
            </WrapPanel>
        </Border>

        <!-- ================= 预览 + 选项 ================= -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="340"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Background="White" CornerRadius="4" Margin="0,0,6,6">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="8,6">
                        <TextBlock x:Name="sizeLabel" Text="16 × 16" VerticalAlignment="Center" FontWeight="SemiBold"/>
                        <TextBlock Text="   放大:" VerticalAlignment="Center" Margin="12,0,4,0"/>
                        <Slider x:Name="zoomSlider" Width="140" Minimum="1" Maximum="16" Value="8"
                                VerticalAlignment="Center" ValueChanged="OnZoomChanged"/>
                        <TextBlock Text="    左: 点阵预览    右: 取模走线" VerticalAlignment="Center"
                                   Foreground="#888" Margin="12,0,0,0"/>
                    </StackPanel>
                    <Grid Grid.Row="1">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <ScrollViewer Grid.Column="0" HorizontalScrollBarVisibility="Auto"
                                      VerticalScrollBarVisibility="Auto" Margin="6">
                            <Image x:Name="previewImage" Stretch="None"
                                   RenderOptions.BitmapScalingMode="NearestNeighbor"/>
                        </ScrollViewer>
                        <ScrollViewer Grid.Column="1" HorizontalScrollBarVisibility="Auto"
                                      VerticalScrollBarVisibility="Auto" Margin="6">
                            <Image x:Name="orderImage" Stretch="None"
                                   RenderOptions.BitmapScalingMode="NearestNeighbor"/>
                        </ScrollViewer>
                    </Grid>
                </Grid>
            </Border>

            <Border Grid.Column="1" Background="White" CornerRadius="4" Margin="0,0,0,6">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="10">
                        <GroupBox Header="点阵格式" Padding="6">
                            <StackPanel Orientation="Horizontal">
                                <RadioButton x:Name="yinCode" Content="阴码 (亮点=1)" IsChecked="True"
                                             Margin="0,0,14,0" Checked="OnCheckedChanged"/>
                                <RadioButton x:Name="yangCode" Content="阳码 (亮点=0)"
                                             Checked="OnCheckedChanged"/>
                            </StackPanel>
                        </GroupBox>

                        <GroupBox Header="取模方式" Padding="6" Margin="0,8,0,0">
                            <StackPanel>
                                <RadioButton x:Name="modeVertical" Content="逐列式" IsChecked="True"
                                             Checked="OnCheckedChanged"/>
                                <RadioButton x:Name="modeHorizontal" Content="逐行式" Margin="0,4,0,0"
                                             Checked="OnCheckedChanged"/>
                                <RadioButton x:Name="modeColumnRow" Content="列行式" Margin="0,4,0,0"
                                             Checked="OnCheckedChanged"/>
                                <RadioButton x:Name="modeRowColumn" Content="行列式" Margin="0,4,0,0"
                                             Checked="OnCheckedChanged"/>
                            </StackPanel>
                        </GroupBox>

                        <GroupBox Header="取模走向" Padding="6" Margin="0,8,0,0">
                            <StackPanel Orientation="Horizontal">
                                <RadioButton x:Name="lsbFirst" Content="逆向 (低位在前)" Margin="0,0,14,0"
                                             Checked="OnCheckedChanged"/>
                                <RadioButton x:Name="msbFirst" Content="顺向 (高位在前)" IsChecked="True"
                                             Checked="OnCheckedChanged"/>
                            </StackPanel>
                        </GroupBox>

                        <GroupBox Header="输出数制与格式" Padding="6" Margin="0,8,0,0">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal">
                                    <RadioButton x:Name="hexMode" Content="十六进制" IsChecked="True"
                                                 Margin="0,0,14,0" Checked="OnCheckedChanged"/>
                                    <RadioButton x:Name="decMode" Content="十进制" Checked="OnCheckedChanged"/>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                                    <TextBlock Text="格式:" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                    <ComboBox x:Name="styleBox" Width="110" Height="24"
                                              SelectionChanged="OnSelectionChanged"/>
                                    <TextBlock Text="每行:" VerticalAlignment="Center" Margin="10,0,4,0"/>
                                    <TextBox x:Name="perLineBox" Width="46" Height="24" Text="16"
                                             VerticalContentAlignment="Center" TextChanged="OnTextChanged"/>
                                    <TextBlock Text="个" VerticalAlignment="Center" Margin="4,0,0,0"/>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                                    <TextBlock Text="数据前缀:" VerticalAlignment="Center"/>
                                    <TextBox x:Name="dataPrefixBox" Width="60" Height="24" Text="0x"
                                             VerticalContentAlignment="Center" TextChanged="OnTextChanged"/>
                                    <TextBlock Text="后缀:" VerticalAlignment="Center" Margin="8,0,4,0"/>
                                    <TextBox x:Name="dataSuffixBox" Width="60" Height="24" Text=","
                                             VerticalContentAlignment="Center" TextChanged="OnTextChanged"/>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                                    <CheckBox x:Name="commentBox" Content="输出注释" IsChecked="True"
                                              VerticalAlignment="Center" Checked="OnCheckedChanged"
                                              Unchecked="OnCheckedChanged"/>
                                    <CheckBox x:Name="indexBox" Content="输出索引" Margin="14,0,0,0"
                                              VerticalAlignment="Center" Checked="OnCheckedChanged"
                                              Unchecked="OnCheckedChanged"/>
                                </StackPanel>
                            </StackPanel>
                        </GroupBox>

                        <GroupBox Header="取模说明" Padding="6" Margin="0,8,0,0">
                            <TextBlock x:Name="helpText" TextWrapping="Wrap" FontSize="11" Foreground="#555"/>
                        </GroupBox>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>

        <!-- ================= 输出 ================= -->
        <Border Grid.Row="2" Background="White" CornerRadius="4" Margin="0,0,0,6">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <TextBlock Grid.Row="0" Text="点阵数据输出区" Margin="8,6,0,2" FontWeight="SemiBold"/>
                <TextBox Grid.Row="1" x:Name="outputBox" IsReadOnly="True" AcceptsReturn="True"
                         FontFamily="Consolas, 宋体" FontSize="12" Margin="6"
                         VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
                         TextWrapping="NoWrap"/>
            </Grid>
        </Border>

        <!-- ================= 操作按钮 ================= -->
        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right">
            <TextBlock x:Name="statusLabel" VerticalAlignment="Center" Margin="0,0,16,0" Foreground="#666"/>
            <Button Content="生成字模" Width="110" Height="30" Margin="0,0,8,0" Click="OnGenerate"/>
            <Button Content="生成字库" Width="100" Height="30" Margin="0,0,8,0" Click="OnLibrary"/>
            <Button Content="复制输出" Width="90" Height="30" Margin="0,0,8,0" Click="OnCopy"/>
            <Button Content="保存字模" Width="90" Height="30" Margin="0,0,8,0" Click="OnSave"/>
            <Button Content="清除数据" Width="90" Height="30" Click="OnClear"/>
        </StackPanel>
    </Grid>
</UserControl>
