<Window x:Class="pix2lcd.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:pix2lcd.Views"
        Title="pix2lcd — 文字 / 图片取模工具" Height="900" Width="1280"
        WindowStartupLocation="CenterScreen"
        Background="#F5F6F8">
    <Grid Margin="6">
        <TabControl x:Name="MainTabs">
            <TabItem Header="  文字取模  ">
                <views:TextModule x:Name="TextPage"/>
            </TabItem>
            <TabItem Header="  图片取模  ">
                <views:ImageModule x:Name="ImagePage"/>
            </TabItem>
        </TabControl>
    </Grid>
</Window>
